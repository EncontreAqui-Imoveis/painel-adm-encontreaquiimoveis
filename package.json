{
  "name": "painelweb-imobiliaria",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:architecture": "node scripts/check-architecture-discipline.cjs",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "ci:verify": "npm run check && npm run test:architecture && npm run test:coverage && npm run build",
    "security:audit": "npm audit --audit-level=high"
  },
  "overrides": {
    "glob": "^10.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.11.1",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "svelte": "^5.53.10",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "axios": "^1.13.6",
    "chart.js": "^4.5.1",
    "lucide-svelte": "^0.553.0",
    "svelte-routing": "^2.13.0",
    "svelte-sonner": "^1.1.0"
  }
}
