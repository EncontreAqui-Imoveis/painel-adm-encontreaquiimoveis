{
  "name": "painelweb-imobiliaria",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:architecture": "node scripts/check-architecture-discipline.cjs",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "ci:verify": "npm run check && npm run test:architecture && npm run test:coverage && npm run build",
    "security:audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^25.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.19",
    "axe-core": "^4.11.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.38",
    "svelte": "^5.35.5",
    "svelte-check": "^4.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "lucide-svelte": "^0.553.0",
    "svelte-routing": "^2.13.0",
    "svelte-sonner": "^1.0.5",
    "xlsx": "^0.18.5"
  }
}
